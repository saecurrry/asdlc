{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "text": {
        "type": "string",
        "minLength": 1
      },
      "blocking": {
        "type": "boolean"
      },
      "answer": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "id",
      "text",
      "blocking",
      "answer"
    ],
    "additionalProperties": false
  }
}
