{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "enum": [
        "worker",
        "review"
      ]
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "artifact_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "content": {
      "type": [
        "string",
        "null"
      ]
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          },
          "answer": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "text",
          "blocking",
          "answer"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "open",
              "resolved"
            ]
          }
        },
        "required": [
          "id",
          "severity",
          "blocking",
          "location",
          "evidence",
          "criterion",
          "impact",
          "resolution",
          "owner",
          "disposition"
        ],
        "additionalProperties": false
      }
    },
    "raid": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "risk",
              "assumption",
              "issue",
              "dependency"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "response": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "closed"
            ]
          },
          "created": {
            "type": "string",
            "minLength": 1
          },
          "updated": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "owner",
          "source",
          "impact",
          "response",
          "status",
          "created",
          "updated"
        ],
        "additionalProperties": false
      }
    },
    "verdict": {
      "enum": [
        "complete",
        "pass",
        "changes_required",
        "needs_human_decision",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "run_id",
    "revision",
    "input_hash",
    "kind",
    "actor",
    "artifact_hash",
    "content",
    "questions",
    "findings",
    "raid",
    "verdict",
    "summary"
  ],
  "additionalProperties": false
}
